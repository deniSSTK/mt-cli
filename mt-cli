#!/bin/sh

CONFIG_FILE="$HOME/.mt_routes"
touch "$CONFIG_FILE"

RESERVED_NAMES="new list delete add get init"

is_reserved() {
    case " $RESERVED_NAMES " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

case "$1" in
    add)
        name="$2"
        raw_path="$3"

        if [ -z "$name" ] || [ -z "$raw_path" ]; then
            echo "Error: name and path are required."
            exit 1
        fi

        if is_reserved "$name"; then
            echo "Error: '$name' is a reserved command name."
            exit 1
        fi

        case "$raw_path" in
            /*)   full_path="$raw_path" ;;
            "~"*) full_path="$HOME${raw_path#\~}" ;;
            *)    full_path="$HOME/$raw_path" ;;
        esac

        grep -v "^${name}|" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" 2>/dev/null
        mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
        echo "${name}|${full_path}" >> "$CONFIG_FILE"
        echo "Saved"
        ;;

    list)
        if [ ! -s "$CONFIG_FILE" ]; then
            echo "Empty"
        else
            awk -F'|' '{printf "%s - %s\n", $1, $2}' "$CONFIG_FILE"
        fi
        ;;

    delete)
        name="$2"
        grep -v "^${name}|" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" 2>/dev/null
        mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
        echo "Deleted"
        ;;

    get)
        grep "^$2|" "$CONFIG_FILE" | cut -d'|' -f2-
        ;;

    init)
        cat << 'EOF'
mt() {
    if [ "$1" = "new" ]; then
        local name="$2"
        local raw_path="$3"

        if [ -z "$name" ]; then
            echo -n "enter name: "
            read name
        fi

        if [ -z "$raw_path" ]; then
            echo -n "enter path: "
            read raw_path
        fi

        command mt add "$name" "$raw_path"
    elif [ "$1" = "list" ] || [ "$1" = "delete" ]; then
        command mt "$@"
    elif [ -z "$1" ]; then
        echo "Usage: mt [new|list|delete|<name>]"
    else
        local target_path=$(command mt get "$1")
        if [ -n "$target_path" ]; then
            if [ -d "$target_path" ]; then
                cd "$target_path"
            else
                echo "Error: directory '$target_path' does not exist."
            fi
        else
            echo "Error: name '$1' not found."
        fi
    fi
}
EOF
        ;;
esac